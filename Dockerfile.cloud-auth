# syntax=docker/dockerfile:1
#
# Example variant of the main Dockerfile for kubeconfigs that use an `exec:`
# credential plugin — the common case for managed clusters (EKS here; see
# the README's "Cloud provider authentication" section for the same pattern
# adapted to GKE/AKS). The main image is `distroless` on purpose (minimal,
# no shell, no CLIs) and can't run `aws eks get-token` itself, so this layers
# the AWS CLI on top of the same binary instead of rebuilding it from source.
#
# Build:
#   docker build -f Dockerfile.cloud-auth -t netsk8-navigator:aws .
#
# Run (mount both the kubeconfig AND the AWS CLI's own credentials):
#   docker run --rm -p 127.0.0.1:8080:8080 \
#     -v "$(readlink -f ~/.kube/config):/kube/config:ro" -e KUBECONFIG=/kube/config \
#     -v "$HOME/.aws:/home/nonroot/.aws:ro" -e AWS_PROFILE=your-profile \
#     netsk8-navigator:aws

ARG BASE_IMAGE=ghcr.io/robertobado/netsk8-navigator:latest
FROM ${BASE_IMAGE} AS app

FROM debian:12-slim
RUN groupadd -g 65532 nonroot \
    && useradd -u 65532 -g 65532 -m -d /home/nonroot -s /usr/sbin/nologin nonroot \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && ARCH=$(dpkg --print-architecture | sed 's/amd64/x86_64/;s/arm64/aarch64/') \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${ARCH}.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws \
    && apt-get purge -y --auto-remove curl unzip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=app /netsk8-navigator /netsk8-navigator

USER 65532:65532
ENV HOME=/home/nonroot
EXPOSE 8080
ENV ADDR=0.0.0.0:8080
ENTRYPOINT ["/netsk8-navigator"]
