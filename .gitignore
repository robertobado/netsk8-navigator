# macOS
.DS_Store

# Agent handoff scratch doc — internal notes, not for the public repo
Memory.md

# Go
backend/backend-bin
backend/*.exe
backend/coverage.out
/dist/

# Frontend
frontend/node_modules/
frontend/dist-ssr/
frontend/*.local

# Frontend build embedded into the Go binary (see internal/web) — generated,
# keep only the placeholder that lets `go build` succeed without it.
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Wails desktop app build output (see backend/cmd/desktop) — generated by
# `wails build`/`wails dev`: the compiled .app and the (unused — this app
# has no JS-bound Go methods) auto-generated JS binding stubs.
backend/cmd/desktop/build/bin/
backend/cmd/desktop/frontend/wailsjs/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea
*.swp
